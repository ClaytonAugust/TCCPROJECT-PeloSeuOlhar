%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 71c832e2ef55603488cb697eb71901c4, type: 3}
  m_Name: cenario2
  m_EditorClassIdentifier: Assembly-CSharp::DadosCenario
  imagemCapa: {fileID: 5017739521265286653, guid: 488a82689950d9941a56197ad98b1425, type: 3}
  nomeCenario: Deixa que eu resolvo
  imagemConclusao: {fileID: 0}
  quadros:
  - titulo: Deixa que eu resolvo
    texto: "narra\xE7\xE3o: A luz da manh\xE3 entra pela janela da cozinha, iluminando
      a mesa onde Dona Helena, aos 70 anos, organiza com cuidado a sua caixa de comprimidos
      da semana e sua caderneta de consultas m\xE9dicas. Manter essa rotina em dia
      \xE9 parte essencial de sua independ\xEAncia e sa\xFAde."
    imagem: {fileID: 5017739521265286653, guid: 488a82689950d9941a56197ad98b1425, type: 3}
    opcoes: []
    exigeEscolha: 0
    definirProximoQuadroManualmente: 0
    proximoQuadroSemEscolha: 0
  - titulo: Deixa que eu resolvo
    texto: "Mas, ao dar uma olhada r\xE1pida na mesa, o Mateus o filho de Dona Helena
      percebe que sua m\xE3e esqueceu de uma consulta m\xE9dica importante. Ele se
      preocupa com a m\xE3e e acha que ela n\xE3o tem mais a capacidade de organizar
      as coisas sozinha."
    imagem: {fileID: -8046184631516179679, guid: 70582e4fa1302094083cae0019d8d7b6, type: 3}
    opcoes: []
    exigeEscolha: 0
    definirProximoQuadroManualmente: 0
    proximoQuadroSemEscolha: 0
  - titulo: Deixa que eu resolvo
    texto: "Tomado pela preocupa\xE7\xE3o, Mateus come\xE7ou a revisar o planejamento
      da pr\xF3xima sema mudando as anota\xE7\xF5es e conferindo os dias de consulta
      para que ela n\xE3o se esque\xE7a de outra consulta , Dona Helena \_come\xE7a
      a ficar incomodada pela intromiss\xE3o repentina do filho."
    imagem: {fileID: 7534935296861606484, guid: 5d3c6a7ef5d11f0428d51f453a60aba4, type: 3}
    opcoes: []
    exigeEscolha: 0
    definirProximoQuadroManualmente: 0
    proximoQuadroSemEscolha: 0
  - titulo: Deixa que eu resolvo
    texto: "Mateus se v\xEA diante de um equil\xEDbrio dif\xEDcil: como cuidar da
      sa\xFAde da m\xE3e sem tirar dela o controle da pr\xF3pria vida?"
    imagem: {fileID: -3640470714710942638, guid: 8358030ac61a8ee4b85e802021aa38f3, type: 3}
    opcoes: []
    exigeEscolha: 0
    definirProximoQuadroManualmente: 0
    proximoQuadroSemEscolha: 0
  - titulo: "O que voc\xEA faria nessa situa\xE7\xE3o?"
    texto: 
    imagem: {fileID: -3640470714710942638, guid: 8358030ac61a8ee4b85e802021aa38f3, type: 3}
    opcoes:
    - textoOpcao: "Deixa que ele cuide de tudo. Ela j\xE1 est\xE1 velha e pode acabar
        esquecendo."
      textoConsequencia: Negativa
      pontuacao: -2
      proximoQuadro: 5
    - textoOpcao: Organiza tudo para ela, mas avisa depois o que foi feito.
      textoConsequencia: Meio negativa
      pontuacao: -1
      proximoQuadro: 6
    - textoOpcao: "Pergunta se ela precisa de ajuda e s\xF3 interfere quando ela
        pedir."
      textoConsequencia: neutra
      pontuacao: 0
      proximoQuadro: 8
    - textoOpcao: "Ajuda a organizar as informa\xE7\xF5es, mas deixa que ela escolha
        como quer controlar seus pr\xF3prios cuidados."
      textoConsequencia: Meio Positiva
      pontuacao: 1
      proximoQuadro: 10
    - textoOpcao: "Conversa com ela, entende quais dificuldades realmente existem
        e oferece ferramentas e apoio para que ela continue participando das decis\xF5es
        sobre a pr\xF3pria sa\xFAde."
      textoConsequencia: Positiva
      pontuacao: 2
      proximoQuadro: 14
    exigeEscolha: 1
    definirProximoQuadroManualmente: 0
    proximoQuadroSemEscolha: 0
  - titulo: 
    texto: "narra\xE7\xE3o: Sem pedir licen\xE7a, Mateus toma a frente e assume o
      controle total da rotina de sa\xFAde da m\xE3e. Ignorando suas vontades \_pois
      \xE9 um mal necess\xE1rio ela j\xE1 n\xE3o tem capacidade de organizar sua
      rotina mais."
    imagem: {fileID: -2482212190511993145, guid: a743ea25d31a0934fbfddacb24d5eea3, type: 3}
    opcoes: []
    exigeEscolha: 0
    definirProximoQuadroManualmente: 1
    proximoQuadroSemEscolha: 14
  - titulo: 
    texto: "narra\xE7\xE3o: Mateus toma a dianteira e reorganiza tudo por conta pr\xF3pria.
      Ele n\xE3o pode confiar que sua m\xE3e fa\xE7a uma tarefa t\xE3o importante
      sozinha"
    imagem: {fileID: 452197297520804635, guid: 69ae19851a778a04bb3bfa90ca33b0ee, type: 3}
    opcoes: []
    exigeEscolha: 0
    definirProximoQuadroManualmente: 1
    proximoQuadroSemEscolha: 7
  - titulo: 
    texto: "fala: M\xE3e est\xE1 tudo organizado, s\xF3 precisa seguir o que est\xE1
      escrito e n\xE3o se esque\xE7a que teremos uma consulta importante na segunda
      de manh\xE3 ."
    imagem: {fileID: 7944109743839845084, guid: b15c0884e444dce47b2a3550c5e98dea, type: 3}
    opcoes: []
    exigeEscolha: 0
    definirProximoQuadroManualmente: 1
    proximoQuadroSemEscolha: 14
  - titulo: 
    texto: "narra\xE7\xE3o: Mateus decide ajudar a sua m\xE3e e perguntando o que
      ainda precisa ser, mas ele se torna o respons\xE1vel por organizar as consultas.\n"
    imagem: {fileID: 6383120972177551673, guid: cda79b0ed59b48e409f664e377984e3a, type: 3}
    opcoes: []
    exigeEscolha: 0
    definirProximoQuadroManualmente: 1
    proximoQuadroSemEscolha: 9
  - titulo: 
    texto: "narra\xE7\xE3o:, Dona Helena entende a preocupa\xE7\xE3o do filho com
      a sua sa\xFAde e aceita que ele tome conta dos dias de consulta."
    imagem: {fileID: 7670775576156265414, guid: 4a789bc58d1e3e0458bbd820fb908847, type: 3}
    opcoes: []
    exigeEscolha: 0
    definirProximoQuadroManualmente: 1
    proximoQuadroSemEscolha: 14
  - titulo: 
    texto: "narra\xE7\xE3o: Mateus decide ajudar a sua m\xE3e perguntando o que ainda
      precisa ser feito e toda altera\xE7\xE3o que ele faz ele avisa a ela e pergunta
      a sua opini\xE3o de sua m\xE3e ."
    imagem: {fileID: 4326038619158674836, guid: 883ff1602acd19f41b313b421375093d, type: 3}
    opcoes: []
    exigeEscolha: 0
    definirProximoQuadroManualmente: 1
    proximoQuadroSemEscolha: 11
  - titulo: 
    texto: "narra\xE7\xE3o . Mateus l\xEA as datas das receitas em voz alta, e Dona
      Helena escreve na caderneta com a letra dela.\n"
    imagem: {fileID: -4718384341936715221, guid: e9f40d3e3933b5c42870592fa2cfe8be, type: 3}
    opcoes: []
    exigeEscolha: 0
    definirProximoQuadroManualmente: 1
    proximoQuadroSemEscolha: 12
  - titulo: 
    texto: "Fala (Dona Helena): \u201CDevagar, menino T\xE1 indo muito r\xE1pido
      .\u201D"
    imagem: {fileID: -4718384341936715221, guid: e9f40d3e3933b5c42870592fa2cfe8be, type: 3}
    opcoes: []
    exigeEscolha: 0
    definirProximoQuadroManualmente: 1
    proximoQuadroSemEscolha: 13
  - titulo: 
    texto: 'Mateus: ri e espera ela terminar'
    imagem: {fileID: -4718384341936715221, guid: e9f40d3e3933b5c42870592fa2cfe8be, type: 3}
    opcoes: []
    exigeEscolha: 0
    definirProximoQuadroManualmente: 1
    proximoQuadroSemEscolha: 14
  - titulo: 
    texto: "Narra\xE7\xE3o: Mateus pensa em pegar a caneta, mas desiste e senta do
      lado da m\xE3e."
    imagem: {fileID: -5526605966550756343, guid: caf8da9eabd16b14daea82c579139d69, type: 3}
    opcoes: []
    exigeEscolha: 0
    definirProximoQuadroManualmente: 1
    proximoQuadroSemEscolha: 15
  - titulo: 
    texto: "Fala (Mateus): \u201CM\xE3e, n\xE3o vim brigar. O que aconteceu com a
      consulta?\u201D"
    imagem: {fileID: -5526605966550756343, guid: caf8da9eabd16b14daea82c579139d69, type: 3}
    opcoes: []
    exigeEscolha: 0
    definirProximoQuadroManualmente: 1
    proximoQuadroSemEscolha: 16
  - titulo: 
    texto: "Fala (Dona Helena): \u201CEsqueci, filho. Fiquei com vergonha de contar\u2026
      A consulta foi remarcada por telefone e eu n\xE3o anotei. E \xE9 rem\xE9dio
      demais, as cartelas s\xE3o todas parecidas.\u201D"
    imagem: {fileID: -4427610741136733771, guid: cc83caccee733bb47b44450edde03b65, type: 3}
    opcoes: []
    exigeEscolha: 0
    definirProximoQuadroManualmente: 1
    proximoQuadroSemEscolha: 17
  - titulo: 
    texto: "Mateus pega a m\xE3o dela. Combinam que ela segue cuidando da caderneta,
      e no domingo os dois olham a semana juntos."
    imagem: {fileID: -4427610741136733771, guid: cc83caccee733bb47b44450edde03b65, type: 3}
    opcoes: []
    exigeEscolha: 0
    definirProximoQuadroManualmente: 1
    proximoQuadroSemEscolha: 18
