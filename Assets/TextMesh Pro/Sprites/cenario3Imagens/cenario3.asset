%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 71c832e2ef55603488cb697eb71901c4, type: 3}
  m_Name: cenario3
  m_EditorClassIdentifier: Assembly-CSharp::DadosCenario
  imagemCapa: {fileID: 483878692087434876, guid: 5a0feee8347b9664bb4d85b7f99ca37f, type: 3}
  nomeCenario: "N\xE3o era isso que aconteceu"
  imagemConclusao: {fileID: 0}
  quadros:
  - titulo: "N\xE3o era isso que aconteceu"
    texto: "Narra\xE7\xE3o: Como sempre, sentada em sua poltrona, Dona Maria percebe
      com afli\xE7\xE3o que sua carteira desapareceu logo ap\xF3s a visita de um
      parente \xE0 sua casa."
    imagem: {fileID: 483878692087434876, guid: 5a0feee8347b9664bb4d85b7f99ca37f, type: 3}
    opcoes: []
    exigeEscolha: 0
    definirProximoQuadroManualmente: 0
    proximoQuadroSemEscolha: 0
  - titulo: "N\xE3o era isso que aconteceu"
    texto: "O sumi\xE7o repentino a deixa muito preocupada e com um sentimento terr\xEDvel
      de vulnerabilidade."
    imagem: {fileID: 2686470822861318503, guid: a45aed67f4e8d524ab52e1a82e39395d, type: 3}
    opcoes: []
    exigeEscolha: 0
    definirProximoQuadroManualmente: 0
    proximoQuadroSemEscolha: 0
  - titulo: "N\xE3o era isso que aconteceu"
    texto: "Narra\xE7\xE3o: Em vez de conversarem diretamente com ela para entender
      os fatos, alguns familiares come\xE7am a espalhar coment\xE1rios pela vizinhan\xE7a
      e entre conhecidos:"
    imagem: {fileID: -6471089572123817001, guid: c8485e759fa9c49478b8f15621c255cf, type: 3}
    opcoes: []
    exigeEscolha: 0
    definirProximoQuadroManualmente: 0
    proximoQuadroSemEscolha: 0
  - titulo: "N\xE3o era isso que aconteceu"
    texto: "Fala da Filha: \u201CEla anda esquecendo das coisas. Quase certeza que
      ela perdeu e esteja culpando algu\xE9m.\u201D"
    imagem: {fileID: -6471089572123817001, guid: c8485e759fa9c49478b8f15621c255cf, type: 3}
    opcoes: []
    exigeEscolha: 0
    definirProximoQuadroManualmente: 0
    proximoQuadroSemEscolha: 0
  - titulo: "N\xE3o era isso que aconteceu"
    texto: "Narra\xE7\xE3o: A hist\xF3ria mal contada se espalha rapidamente de pessoa
      para pessoa na vizinhan\xE7a, e acaba transformando um mal-entendido em um
      julgamento sobre a sanidade e a mem\xF3ria de Dona Maria, sem que ningu\xE9m
      cogite perguntar seu lado da hist\xF3ria."
    imagem: {fileID: 5220287062762190157, guid: 1409dc0172fb2f74d94232eaae0a3895, type: 3}
    opcoes: []
    exigeEscolha: 0
    definirProximoQuadroManualmente: 0
    proximoQuadroSemEscolha: 0
  - titulo: "N\xE3o era isso que aconteceu"
    texto: "Quando finalmente falam com ela, Dona Maria descobre que j\xE1 existe
      uma hist\xF3ria sobre o que teria acontecido \u2014 mas ningu\xE9m ouviu sua
      vers\xE3o."
    imagem: {fileID: 5642213674493751873, guid: 4b9ce2be31a5baf4bb94cbb1c21921d0, type: 3}
    opcoes: []
    exigeEscolha: 0
    definirProximoQuadroManualmente: 0
    proximoQuadroSemEscolha: 0
  - titulo: "o que faria nessa situa\xE7\xE3o?"
    texto: 
    imagem: {fileID: 5642213674493751873, guid: 4b9ce2be31a5baf4bb94cbb1c21921d0, type: 3}
    opcoes:
    - textoOpcao: "Acreditaria na fam\xEDlia e evitaria discutir para n\xE3o criar
        confus\xE3o."
      textoConsequencia: 
      pontuacao: -2
      proximoQuadro: 7
    - textoOpcao: Ouviria Dona Maria, mas continuaria acreditando mais no que os
        outros disseram.
      textoConsequencia: 
      pontuacao: -1
      proximoQuadro: 10
    - textoOpcao: "Escutar todo mundo antes de tirar conclus\xF5es precipitadas"
      textoConsequencia: 
      pontuacao: 0
      proximoQuadro: 13
    - textoOpcao: " Conversaria diretamente com Dona Maria e daria espa\xE7o para
        ela se explicar."
      textoConsequencia: 
      pontuacao: 1
      proximoQuadro: 16
    - textoOpcao: "Evitaria espalhar falsas acusa\xE7\xF5es, e conversaria diretamente
        com ela buscando entender os fatos antes de fazer qualquer julgamento."
      textoConsequencia: 
      pontuacao: 2
      proximoQuadro: 18
    exigeEscolha: 1
    definirProximoQuadroManualmente: 0
    proximoQuadroSemEscolha: 0
  - titulo: 
    texto: "nara\xE7\xE3o: quando a fam\xEDlia se junta e come\xE7a a falar sobre
      o ocorrido a dona Maria \xE9 ignorada e quando pede para seu filho esclarecer
      o ocorrido ele a responder"
    imagem: {fileID: -6193580140439365942, guid: bb501047e5228ae4d823f90b804a3230, type: 3}
    opcoes: []
    exigeEscolha: 0
    definirProximoQuadroManualmente: 1
    proximoQuadroSemEscolha: 8
  - titulo: 
    texto: "Fala (Vaguiner): M\xE3e, \xE9 melhor deixar isso quieto. N\xE3o quero
      confus\xE3o na fam\xEDlia por causa dessa hist\xF3ria."
    imagem: {fileID: -6193580140439365942, guid: bb501047e5228ae4d823f90b804a3230, type: 3}
    opcoes: []
    exigeEscolha: 0
    definirProximoQuadroManualmente: 1
    proximoQuadroSemEscolha: 9
  - titulo: 
    texto: "Pensamento de Dona Maria: Eu s\xF3 queria que acreditassem em mim..."
    imagem: {fileID: -6193580140439365942, guid: bb501047e5228ae4d823f90b804a3230, type: 3}
    opcoes: []
    exigeEscolha: 0
    definirProximoQuadroManualmente: 1
    proximoQuadroSemEscolha: 20
  - titulo: 
    texto: "nara\xE7\xE3o: quando a fam\xEDlia se junta e come\xE7a a falar sobre
      o ocorrido a dona Maria \xE9 ignorada e quando pede para seu filho esclarecer
      o ocorrido ele a respnde"
    imagem: {fileID: -6193580140439365942, guid: bb501047e5228ae4d823f90b804a3230, type: 3}
    opcoes: []
    exigeEscolha: 0
    definirProximoQuadroManualmente: 1
    proximoQuadroSemEscolha: 11
  - titulo: 
    texto: "Fala (Vaguiner): Algu\xE9m viu a carteira ser levada ou est\xE3o apenas
      supondo que foi isso que aconteceu?"
    imagem: {fileID: -6193580140439365942, guid: bb501047e5228ae4d823f90b804a3230, type: 3}
    opcoes: []
    exigeEscolha: 0
    definirProximoQuadroManualmente: 1
    proximoQuadroSemEscolha: 12
  - titulo: 
    texto: "Narra\xE7\xE3o: ent\xE3o Dona Maria tenta explicar que n\xE3o acusou
      ningu\xE9m e que s\xF3 quer encontrar sua carteira. Vaguiner e os familiares
      escutam mas n\xE3o acreditam totalmente nela."
    imagem: {fileID: -6193580140439365942, guid: bb501047e5228ae4d823f90b804a3230, type: 3}
    opcoes: []
    exigeEscolha: 0
    definirProximoQuadroManualmente: 1
    proximoQuadroSemEscolha: 20
  - titulo: 
    texto: "Fala (Vaguiner): Algu\xE9m viu a carteira ser levada ou est\xE3o apenas
      supondo que foi isso que aconteceu?"
    imagem: {fileID: 3818358001283424448, guid: 37da066266af2d741af4d4d0a287676c, type: 3}
    opcoes: []
    exigeEscolha: 0
    definirProximoQuadroManualmente: 1
    proximoQuadroSemEscolha: 14
  - titulo: 
    texto: "Narra\xE7\xE3o: Os familiares n\xE3o sabem responder. Cada um repete
      o que ouviu de outra pessoa, e Vaguiner percebe que ningu\xE9m tem certeza
      do que aconteceu."
    imagem: {fileID: 3818358001283424448, guid: 37da066266af2d741af4d4d0a287676c, type: 3}
    opcoes: []
    exigeEscolha: 0
    definirProximoQuadroManualmente: 1
    proximoQuadroSemEscolha: 15
  - titulo: 
    texto: "Fala (Vaguiner): M\xE3e, conversei com o pessoal e ningu\xE9m sabe ao
      certo o que aconteceu. a hist\xF3ria se tornou confusa e ningu\xE9m sabe o
      que realmente aconteceu "
    imagem: {fileID: -1260915394643745088, guid: e0ca6a4d42b71de4dafa4807c13c0d50, type: 3}
    opcoes: []
    exigeEscolha: 0
    definirProximoQuadroManualmente: 1
    proximoQuadroSemEscolha: 20
  - titulo: 
    texto: "Narra\xE7\xE3o: Depois de saber dos coment\xE1rios, Vaguiner decide conversar
      com a m\xE3e. Ele se senta perto dela e espera que ela termine o que est\xE1
      fazendo antes de tocar no assunto."
    imagem: {fileID: -2071131800922814628, guid: 2bc6446f6b0990e48b9609148bbd8eb3, type: 3}
    opcoes: []
    exigeEscolha: 0
    definirProximoQuadroManualmente: 1
    proximoQuadroSemEscolha: 17
  - titulo: 
    texto: "Fala (Vaguiner): M\xE3e, a J\xFAlia me contou o que est\xE3o dizendo
      sobre a carteira. Queria ouvir o que a senhora pensa sobre tudo isso."
    imagem: {fileID: -2071131800922814628, guid: 2bc6446f6b0990e48b9609148bbd8eb3, type: 3}
    opcoes: []
    exigeEscolha: 0
    definirProximoQuadroManualmente: 1
    proximoQuadroSemEscolha: 20
  - titulo: 
    texto: "Narra\xE7\xE3o: Vaguiner se senta ao lado da m\xE3e e pergunta o que
      ela pensa sobre os coment\xE1rios. Dona Maria explica que nunca acusou ningu\xE9m
      e que o que mais a magoa \xE9 ver sua palavra questionada sem que tenham procurado
      ouvi-la."
    imagem: {fileID: 682583307798161911, guid: 62fe64878ef9c5541ba8880562524771, type: 3}
    opcoes: []
    exigeEscolha: 0
    definirProximoQuadroManualmente: 1
    proximoQuadroSemEscolha: 19
  - titulo: 
    texto: "Narra\xE7\xE3o: Depois de ouvir a m\xE3e, Vaguiner re\xFAne os familiares
      e explica que ningu\xE9m sabia ao certo o que havia acontecido. Ele pede que
      parem de espalhar suspeitas e que conversem diretamente com Dona Maria antes
      de tirar conclus\xF5es."
    imagem: {fileID: 6824480284524792502, guid: 4f715afd0322c1245b6b5b5be2043c0c, type: 3}
    opcoes: []
    exigeEscolha: 0
    definirProximoQuadroManualmente: 1
    proximoQuadroSemEscolha: 20
