%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 71c832e2ef55603488cb697eb71901c4, type: 3}
  m_Name: cenario1
  m_EditorClassIdentifier: Assembly-CSharp::DadosCenario
  imagemCapa: {fileID: -2329959863234833854, guid: 26ed22e44825b4946a300c5e11e66ab3, type: 3}
  nomeCenario: A casa ficou silenciosa
  imagemConclusao: {fileID: 0}
  quadros:
  - titulo: A casa ficou silenciosa
    texto: "A tarde vai chegando e o tempo passa devagar. <b>Seu Ant\xF4nio</b>,
      aos 74 anos, est\xE1 sentado na sala, em sua poltrona. Ao seu redor, nada al\xE9m
      do sil\xEAncio, inc\xF4modo e enorme, preenchendo toda a casa. Na parede, os
      porta-retratos guardam mem\xF3rias de tempos que n\xE3o voltam mais."
    imagem: {fileID: -2329959863234833854, guid: 26ed22e44825b4946a300c5e11e66ab3, type: 3}
    opcoes: []
    exigeEscolha: 0
    definirProximoQuadroManualmente: 0
    proximoQuadroSemEscolha: 0
  - titulo: A casa ficou silenciosa
    texto: "O toque do telefone quebra o sil\xEAncio. \xC9 a sua filha, preocupada
      com o pai."
    imagem: {fileID: 9094543361801899733, guid: 1b0dbf593213cce4b9ffc5ba9900cce0, type: 3}
    opcoes: []
    exigeEscolha: 0
    definirProximoQuadroManualmente: 0
    proximoQuadroSemEscolha: 0
  - titulo: A casa ficou silenciosa
    texto: "<b>Catarina</b><i> -Boa tarde, pai. Eu estou ligando para saber como
      v\xE3o as coisas. Desde que a m\xE3e morreu, eu ando preocupada com o senhor.</i>"
    imagem: {fileID: 9094543361801899733, guid: 1b0dbf593213cce4b9ffc5ba9900cce0, type: 3}
    opcoes: []
    exigeEscolha: 0
    definirProximoQuadroManualmente: 0
    proximoQuadroSemEscolha: 0
  - titulo: A casa ficou silenciosa
    texto: "<b>Seu Ant\xF4nio</b> olha para a mesa posta para o caf\xE9, um costume
      que mant\xE9m vivo mesmo depois da partida da esposa. Pensa na dor da aus\xEAncia
      e em tudo o que viveram juntos. Agora, sua companheira \xE9 a solid\xE3o."
    imagem: {fileID: 9094543361801899733, guid: 1b0dbf593213cce4b9ffc5ba9900cce0, type: 3}
    opcoes: []
    exigeEscolha: 0
    definirProximoQuadroManualmente: 0
    proximoQuadroSemEscolha: 0
  - titulo: A casa ficou silenciosa
    texto: Ele respira fundo.
    imagem: {fileID: 9094543361801899733, guid: 1b0dbf593213cce4b9ffc5ba9900cce0, type: 3}
    opcoes: []
    exigeEscolha: 0
    definirProximoQuadroManualmente: 0
    proximoQuadroSemEscolha: 0
  - titulo: A casa ficou silenciosa
    texto: "Em sua pr\xF3pria casa, <b>Catarina</b> n\xE3o sabe o que fazer. Os afazeres
      da semana pesam sobre seus ombros, e ela est\xE1 esgotada. Mesmo assim, a consci\xEAncia
      pesa: sabe que o pai n\xE3o est\xE1 bem."
    imagem: {fileID: 1334960847774182391, guid: d7ebc84e59198b342a6c490236b34310, type: 3}
    opcoes: []
    exigeEscolha: 0
    definirProximoQuadroManualmente: 0
    proximoQuadroSemEscolha: 0
  - titulo: A casa ficou silenciosa
    texto: "<b>Catarina</b> est\xE1 em um dilema: manter a dedica\xE7\xE3o ao trabalho
      ou oferecer sua companhia ao pai, que n\xE3o parece estar lidando bem com a
      solid\xE3o. O que ela deve fazer?"
    imagem: {fileID: 1334960847774182391, guid: d7ebc84e59198b342a6c490236b34310, type: 3}
    opcoes: []
    exigeEscolha: 0
    definirProximoQuadroManualmente: 0
    proximoQuadroSemEscolha: 0
  - titulo: O que ela deve fazer?
    texto: 
    imagem: {fileID: 3736540879100028168, guid: f083b45aa53415640a72ebfbc53c87e6, type: 3}
    opcoes:
    - textoOpcao: "Ele precisa se acostumar. N\xE3o d\xE1 para ficar indo l\xE1 toda
        hora."
      textoConsequencia: "Com o passar dos dias, Catarina acaba se envolvendo cada
        vez mais com as responsabilidades do trabalho e deixa as visitas para depois.
        Seu Ant\xF4nio continua sentado em sua poltrona, mantendo os mesmos h\xE1bitos
        de sempre, mas a casa permanece silenciosa. As liga\xE7\xF5es se tornam cada
        vez mais raras, e ele passa a sentir falta at\xE9 das pequenas conversas
        que costumava ter com a filha. Mesmo sem reclamar, come\xE7a a acreditar
        que precisa se acostumar com a solid\xE3o."
      textoFeedback: "Perder algu\xE9m com quem se dividiu a vida muda tudo: a rotina,
        a casa, at\xE9 o gosto do caf\xE9 da tarde. O luto n\xE3o passa apenas com
        o tempo. Quem perde algu\xE9m precisa de espa\xE7o para sentir a falta e,
        ao mesmo tempo, de apoio para reorganizar a vida. Muitas pessoas idosas n\xE3o
        pedem ajuda para n\xE3o incomodar os filhos, e por isso a solid\xE3o pode
        crescer sem que ningu\xE9m perceba, at\xE9 virar parte do dia a dia.\n\nEstar
        presente nem sempre exige muito tempo. Uma liga\xE7\xE3o sem pressa, uma
        pergunta sobre quem se foi ou uma foto antiga podem fazer diferen\xE7a para
        quem est\xE1 de luto. Cuidar de si \xE9 importante, mas o afastamento tamb\xE9m
        tem um custo, e muitas vezes quem paga \xE9 quem est\xE1 do outro lado. Voc\xEA
        conhece algu\xE9m que est\xE1 passando por uma perda? Quando foi a \xFAltima
        vez que perguntou como essa pessoa est\xE1 de verdade?"
      pontuacao: 0
      proximoQuadro: 8
    - textoOpcao: "Liga para ele de vez em quando, s\xF3 para saber se est\xE1 tudo
        bem."
      textoConsequencia: "Catarina tenta manter contato com o pai por meio de liga\xE7\xF5es
        durante a semana. Seu Ant\xF4nio fica contente ao ouvir a voz da filha, mas
        as conversas s\xE3o r\xE1pidas e as visitas continuam raras. Com a rotina
        cada vez mais cheia, Catarina consegue ir \xE0 casa dele apenas em ocasi\xF5es
        especiais. Mesmo agradecido pelas liga\xE7\xF5es, Seu Ant\xF4nio sente falta
        de ter a filha por perto e de compartilhar com ela os pequenos momentos do
        dia a dia."
      textoFeedback: "Existe uma diferen\xE7a entre ter contato com algu\xE9m e se
        sentir pr\xF3ximo dessa pessoa. \xC9 poss\xEDvel falar com a fam\xEDlia toda
        semana e, mesmo assim, sentir falta de algu\xE9m com quem dividir as pequenas
        coisas: o caf\xE9 da tarde, uma lembran\xE7a, uma not\xEDcia qualquer. Para
        quem perdeu o companheiro de uma vida inteira, essa falta pesa ainda mais,
        porque era com ele que esses momentos eram divididos. Uma liga\xE7\xE3o r\xE1pida
        confirma que est\xE1 tudo bem, mas nem sempre alcan\xE7a o que a pessoa realmente
        est\xE1 sentindo.\n\n\xC0s vezes, o que ajuda n\xE3o \xE9 ligar mais vezes,
        e sim ligar com mais tempo, e sem pressa de desligar. Perguntar sobre o dia,
        ouvir uma hist\xF3ria antiga ou simplesmente conversar sem um motivo j\xE1
        \xE9 uma forma de presen\xE7a. Voc\xEA costuma conversar de verdade com as
        pessoas que ama, ou s\xF3 confirmar se est\xE1 tudo bem?"
      pontuacao: 0
      proximoQuadro: 12
    - textoOpcao: "Pergunta se ele quer companhia, mas deixa a decis\xE3o totalmente
        por conta dele."
      textoConsequencia: "Catarina envia uma mensagem ao pai, dizendo que pode visit\xE1-lo
        quando ele quiser. Seu Ant\xF4nio fica contente ao perceber que a filha se
        preocupa com ele, mas n\xE3o sabe quando pedir essa companhia. Algumas vezes,
        ele pega o telefone para cham\xE1-la, mas desiste: \u201CEla deve estar ocupada.\u201D
        Os dias continuam passando e, embora mantenham algum contato, as visitas
        n\xE3o se tornam frequentes. A casa continua silenciosa na maior parte do
        tempo, e os dois ainda esperam por uma oportunidade de se aproximar."
      textoFeedback: "Muitas pessoas idosas evitam pedir ajuda por medo de incomodar
        ou de se tornar um peso para a fam\xEDlia. Quando a oferta \xE9 \u201Cme
        chama quando precisar\u201D, a iniciativa fica justamente com quem est\xE1
        mais fragilizado. No luto, isso fica ainda mais dif\xEDcil, porque a tristeza
        costuma tirar a energia e a vontade de procurar o outro. Assim, uma oferta
        sincera pode acabar nunca sendo usada.\n\nUm convite com dia e hora marcados,
        como \u201Cposso passar a\xED no s\xE1bado \xE0 tarde?\u201D, costuma funcionar
        melhor do que uma oferta em aberto. Ele mostra que a visita \xE9 desejada,
        e n\xE3o um favor, e tira de quem est\xE1 sofrendo o peso de ter que pedir.
        Voc\xEA j\xE1 deixou de procurar algu\xE9m por achar que estaria incomodando?
        E algu\xE9m j\xE1 deixou de procurar voc\xEA pelo mesmo motivo?"
      pontuacao: 0
      proximoQuadro: 17
    - textoOpcao: "Combina de visit\xE1-lo com mais frequ\xEAncia e procura manter
        contato durante a semana."
      textoConsequencia: "Com o passar dos dias, Catarina passa a organizar melhor
        sua rotina para estar mais presente na vida do pai. As visitas se tornam
        mais frequentes, e os dois come\xE7am a recuperar pequenos momentos de conviv\xEAncia.
        Seu Ant\xF4nio volta a folhear os antigos \xE1lbuns de fam\xEDlia e compartilhar
        hist\xF3rias que h\xE1 muito tempo n\xE3o contava. A casa, antes marcada
        pelo sil\xEAncio, ganha novamente espa\xE7o para conversas e risadas. Mesmo
        com as dificuldades do dia a dia, Catarina faz quest\xE3o de manter esse
        v\xEDnculo, e Seu Ant\xF4nio percebe que n\xE3o precisa enfrentar a solid\xE3o
        sozinho."
      textoFeedback: "Depois de uma perda, uma das coisas que mais faz falta \xE9
        a rotina compartilhada: algu\xE9m para tomar caf\xE9 junto, ouvir uma hist\xF3ria,
        dividir o fim da tarde. Quando essa conviv\xEAncia volta, mesmo que de outro
        jeito, a solid\xE3o diminui. Relembrar o passado com algu\xE9m tamb\xE9m
        \xE9 importante na velhice, porque ajuda a pessoa a dar sentido \xE0 pr\xF3pria
        hist\xF3ria, em vez de guard\xE1-la s\xF3 na mem\xF3ria. Cada foto do \xE1lbum
        vira uma oportunidade de ser ouvido.\n\nAinda assim, a saudade da esposa
        continuou guardada. Seu Ant\xF4nio voltou a falar do passado, mas n\xE3o
        da dor que sentia no presente. \xC0s vezes, al\xE9m de estar presente, \xE9
        preciso abrir espa\xE7o para falar de quem se foi. Voc\xEA costuma perguntar
        \xE0s pessoas mais velhas sobre a hist\xF3ria delas? E sobre o que elas est\xE3o
        sentindo agora?"
      pontuacao: 0
      proximoQuadro: 21
    - textoOpcao: "Conversa com ele sobre o que est\xE1 sentindo"
      textoConsequencia: "Em vez de apenas ligar, Catarina pergunta ao pai como ele
        est\xE1. Desta vez, Seu Ant\xF4nio n\xE3o hesita: fala da saudade da esposa,
        das tardes em que tomavam caf\xE9 juntos e do sil\xEAncio que ficou na casa.
        Catarina escuta sem pressa e, pela primeira vez desde a perda da m\xE3e,
        os dois choram juntos.\nNas semanas seguintes, ela passa a visit\xE1-lo com
        frequ\xEAncia e leva o filho junto. \xC0 mesa do caf\xE9, agora posta para
        tr\xEAs, Seu Ant\xF4nio mostra os \xE1lbuns de fam\xEDlia e conta hist\xF3rias
        que o neto nunca tinha ouvido. A casa, antes silenciosa, volta a ter vozes."
      textoFeedback: "Muitas fam\xEDlias evitam falar sobre quem morreu, com medo
        de reabrir feridas. Mas, para quem est\xE1 de luto, poder falar da pessoa
        que partiu \xE9 uma parte importante do processo, e o sil\xEAncio sobre o
        assunto pode fazer a dor parecer ainda mais solit\xE1ria. A perda tamb\xE9m
        n\xE3o era s\xF3 de Seu Ant\xF4nio: Catarina tinha perdido a m\xE3e. Dividir
        a dor fez com que nenhum dos dois precisasse carreg\xE1-la sozinho.\n\nA
        saudade n\xE3o vai embora, mas pode ser vivida em companhia. \xC0s vezes,
        a pergunta mais simples, \u201Ccomo voc\xEA est\xE1 de verdade?\u201D, \xE9
        a que abre espa\xE7o para o que estava guardado. Existe algu\xE9m na sua
        vida com quem voc\xEA nunca conversou sobre uma perda que voc\xEAs dois sentiram?"
      pontuacao: 0
      proximoQuadro: 26
    exigeEscolha: 1
    definirProximoQuadroManualmente: 0
    proximoQuadroSemEscolha: 0
  - titulo: A casa ficou silenciosa
    texto: "<b>Catarina</b>  <i>-Pai, essa semana vai ser puxada no trabalho. N\xE3o
      vou conseguir ir a\xED por um tempo. </i>"
    imagem: {fileID: -995822636085515590, guid: 31e30c633e5891843919ecaf31f767e7, type: 3}
    opcoes: []
    exigeEscolha: 0
    definirProximoQuadroManualmente: 1
    proximoQuadroSemEscolha: 9
  - titulo: A casa ficou silenciosa
    texto: "<b>Seu Ant\xF4nio</b> <i>-Tudo bem, filha\u2026 N\xE3o se preocupa comigo.</i>"
    imagem: {fileID: -995822636085515590, guid: 31e30c633e5891843919ecaf31f767e7, type: 3}
    opcoes: []
    exigeEscolha: 0
    definirProximoQuadroManualmente: 1
    proximoQuadroSemEscolha: 10
  - titulo: A casa ficou silenciosa
    texto: <b>Catarina</b> <i>-O senhor vai ficar bem, pai. Com o tempo, a gente
      se acostuma.</i>
    imagem: {fileID: -995822636085515590, guid: 31e30c633e5891843919ecaf31f767e7, type: 3}
    opcoes: []
    exigeEscolha: 0
    definirProximoQuadroManualmente: 1
    proximoQuadroSemEscolha: 11
  - titulo: A casa ficou silenciosa
    texto: "<b>Ao desligar</b>, Catarina solta um suspiro de exaust\xE3o e afasta
      o celular. A semana vai ser dif\xEDcil, e ela precisa aproveitar os momentos
      livres para descansar. Promete a si mesma que vai compensar depois, quando
      der. Do outro lado da linha, Seu Ant\xF4nio continua segurando o telefone por
      alguns segundos."
    imagem: {fileID: -4923229942648506911, guid: 3f814dc4e668fcb40a3e5a684e61107c, type: 3}
    opcoes: []
    exigeEscolha: 0
    definirProximoQuadroManualmente: 1
    proximoQuadroSemEscolha: 20
  - titulo: A casa ficou silenciosa
    texto: "<b>Catarina</b> <i>-Oi, pai, tudo bem por a\xED?</i>"
    imagem: {fileID: 9193702694993886150, guid: 9b5e02aa615454241992d09db09f0c40, type: 3}
    opcoes: []
    exigeEscolha: 0
    definirProximoQuadroManualmente: 1
    proximoQuadroSemEscolha: 13
  - titulo: A casa ficou silenciosa
    texto: "<b>Seu Ant\xF4nio</b> <i>-Tudo, filha. T\xF4 aqui, tomando um caf\xE9.</i>"
    imagem: {fileID: 9193702694993886150, guid: 9b5e02aa615454241992d09db09f0c40, type: 3}
    opcoes: []
    exigeEscolha: 0
    definirProximoQuadroManualmente: 1
    proximoQuadroSemEscolha: 14
  - titulo: A casa ficou silenciosa
    texto: "<b>Catarina</b> <i>-Que bom. Olha, essa semana t\xE1 corrida, n\xE3o
      vou conseguir passar a\xED. Mas eu ligo mais, t\xE1 bom?</i>"
    imagem: {fileID: 9193702694993886150, guid: 9b5e02aa615454241992d09db09f0c40, type: 3}
    opcoes: []
    exigeEscolha: 0
    definirProximoQuadroManualmente: 1
    proximoQuadroSemEscolha: 15
  - titulo: A casa ficou silenciosa
    texto: "<b>Seu Ant\xF4nio</b> <i>-T\xE1 bom, filha. Vai l\xE1.</i>"
    imagem: {fileID: 9193702694993886150, guid: 9b5e02aa615454241992d09db09f0c40, type: 3}
    opcoes: []
    exigeEscolha: 0
    definirProximoQuadroManualmente: 1
    proximoQuadroSemEscolha: 16
  - titulo: A casa ficou silenciosa
    texto: "Ela tenta manter mais contato com o seu pai por meio de liga\xE7\xF5es
      mas a sua rotina pesada torna as visitas a ele quase proibitivas para ela,
      indo em apenas ocasi\xF5es especiais ."
    imagem: {fileID: -4923229942648506911, guid: 3f814dc4e668fcb40a3e5a684e61107c, type: 3}
    opcoes: []
    exigeEscolha: 0
    definirProximoQuadroManualmente: 1
    proximoQuadroSemEscolha: 30
  - titulo: A casa ficou silenciosa
    texto: "<b>Catarina</b><i> -Pai, se o senhor quiser companhia, \xE9 s\xF3 me
      avisar que eu passo a\xED, t\xE1?</i>"
    imagem: {fileID: 8538734835328285091, guid: 68088e0297764094e970e964e3d2a000, type: 3}
    opcoes: []
    exigeEscolha: 0
    definirProximoQuadroManualmente: 1
    proximoQuadroSemEscolha: 18
  - titulo: A casa ficou silenciosa
    texto: "<b>Seu Ant\xF4nio</b><i> -T\xE1 bom, filha. Se eu precisar, eu te chamo.</i>"
    imagem: {fileID: 8538734835328285091, guid: 68088e0297764094e970e964e3d2a000, type: 3}
    opcoes: []
    exigeEscolha: 0
    definirProximoQuadroManualmente: 1
    proximoQuadroSemEscolha: 19
  - titulo: A casa ficou silenciosa
    texto: "<b>Catarina</b> desliga tranquila, achando que deixou tudo combinado.
      Seu Ant\xF4nio fica feliz com o convite, mas n\xE3o diz quando quer que ela
      venha."
    imagem: {fileID: 8538734835328285091, guid: 68088e0297764094e970e964e3d2a000, type: 3}
    opcoes: []
    exigeEscolha: 0
    definirProximoQuadroManualmente: 1
    proximoQuadroSemEscolha: 20
  - titulo: A casa ficou silenciosa
    texto: "Ela percebe que o seu pai est\xE1 se sentindo s\xF3, ent\xE3o ela reorganiza
      a sua rotina, podendo visit\xE1-lo em poucos momentos, para que seu velho pai
      n\xE3o sofra tanto"
    imagem: {fileID: 5097590544626389610, guid: b10a96b823eaea54aad652465c824fbc, type: 3}
    opcoes: []
    exigeEscolha: 0
    definirProximoQuadroManualmente: 1
    proximoQuadroSemEscolha: 31
  - titulo: A casa ficou silenciosa
    texto: "<b>Catarina</b> abre a agenda e olha a semana. Est\xE1 cheia, mas ela
      encontra espa\xE7o na quarta \xE0 noite e no s\xE1bado \xE0 tarde."
    imagem: {fileID: -1561652621127624007, guid: 4ffc35dcdb608354ab2caf6673e870ec, type: 3}
    opcoes: []
    exigeEscolha: 0
    definirProximoQuadroManualmente: 1
    proximoQuadroSemEscolha: 22
  - titulo: A casa ficou silenciosa
    texto: "<b>Catarina</b><i> -Pai, consegui separar a quarta e o s\xE1bado pra
      ficar com o senhor. Pode ser?</i>"
    imagem: {fileID: -1561652621127624007, guid: 4ffc35dcdb608354ab2caf6673e870ec, type: 3}
    opcoes: []
    exigeEscolha: 0
    definirProximoQuadroManualmente: 1
    proximoQuadroSemEscolha: 23
  - titulo: A casa ficou silenciosa
    texto: "<b>Seu Ant\xF4nio</b><i> -Pode, filha! Vou deixar o caf\xE9 pronto.</i>"
    imagem: {fileID: -1561652621127624007, guid: 4ffc35dcdb608354ab2caf6673e870ec, type: 3}
    opcoes: []
    exigeEscolha: 0
    definirProximoQuadroManualmente: 1
    proximoQuadroSemEscolha: 24
  - titulo: A casa ficou silenciosa
    texto: "<b>Catarina</b></i> -E nos outros dias eu te ligo \xE0 noite, pra gente
      conversar um pouco.</i>"
    imagem: {fileID: -1561652621127624007, guid: 4ffc35dcdb608354ab2caf6673e870ec, type: 3}
    opcoes: []
    exigeEscolha: 0
    definirProximoQuadroManualmente: 1
    proximoQuadroSemEscolha: 25
  - titulo: A casa ficou silenciosa
    texto: "<b>Seu Ant\xF4nio</b> desliga sorrindo. Sabe que a filha anda ocupada
      e, mesmo assim, ela arrumou tempo para ele."
    imagem: {fileID: 6028183830578997635, guid: c7f1f9227b826c445ac0f43c78b6d842, type: 3}
    opcoes: []
    exigeEscolha: 0
    definirProximoQuadroManualmente: 1
    proximoQuadroSemEscolha: 31
  - titulo: A casa ficou silenciosa
    texto: "<b>Catarina</b><i> -Pai, eu n\xE3o liguei s\xF3 pra saber se t\xE1 tudo
      bem. Quero saber como o senhor est\xE1 de verdade. T\xE1 muito dif\xEDcil sem
      a m\xE3e, n\xE9? </i>"
    imagem: {fileID: -7933959484852203323, guid: df4bcc52276f0e944bec15bfd40d4972, type: 3}
    opcoes: []
    exigeEscolha: 0
    definirProximoQuadroManualmente: 1
    proximoQuadroSemEscolha: 27
  - titulo: A casa ficou silenciosa
    texto: "Do outro lado da linha, <b>Seu Ant\xF4nio</b> fica em sil\xEAncio por
      um tempo. <b>Catarina</b> n\xE3o apressa a resposta."
    imagem: {fileID: -7933959484852203323, guid: df4bcc52276f0e944bec15bfd40d4972, type: 3}
    opcoes: []
    exigeEscolha: 0
    definirProximoQuadroManualmente: 1
    proximoQuadroSemEscolha: 28
  - titulo: A casa ficou silenciosa
    texto: "<b>Seu Ant\xF4nio</b><i> -\xC9, filha\u2026 A casa ficou quieta demais.</i>"
    imagem: {fileID: -7933959484852203323, guid: df4bcc52276f0e944bec15bfd40d4972, type: 3}
    opcoes: []
    exigeEscolha: 0
    definirProximoQuadroManualmente: 1
    proximoQuadroSemEscolha: 29
  - titulo: A casa ficou silenciosa
    texto: "No fim da tarde, <b>Catarina</b> chega \xE0 casa do pai. Os dois se sentam
      no sof\xE1, e <b>Seu Ant\xF4nio</b>, aos poucos, come\xE7a a falar da saudade
      da esposa. <b>Catarina</b> escuta sem pressa, sem mudar de assunto."
    imagem: {fileID: 2179803957164162282, guid: f8ac7ce813f08ee4fbbd05b3c327407d, type: 3}
    opcoes: []
    exigeEscolha: 0
    definirProximoQuadroManualmente: 1
    proximoQuadroSemEscolha: 30
  - titulo: A casa ficou silenciosa
    texto: "Nos domingos seguintes, <b>Catarina</b> volta com o filho. Enquanto o
      neto aprende a jogar xadrez com o av\xF4, <b>Seu Ant\xF4nio</b> abre o \xE1lbum
      de fam\xEDlia e conta hist\xF3rias de quando era jovem. A casa, antes silenciosa,
      volta a ter conversas e risadas."
    imagem: {fileID: -3785770787563733714, guid: acc9a2d1ab9a90846a78a0e0ede88c01, type: 3}
    opcoes: []
    exigeEscolha: 0
    definirProximoQuadroManualmente: 1
    proximoQuadroSemEscolha: 31
