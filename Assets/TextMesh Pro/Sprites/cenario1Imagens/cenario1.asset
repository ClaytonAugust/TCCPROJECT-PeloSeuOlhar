MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 71c832e2ef55603488cb697eb71901c4, type: 3}
  m_Name: cenario1
  m_EditorClassIdentifier: Assembly-CSharp::DadosCenario
  imagemCapa: {fileID: 9094543361801899733, guid: 1b0dbf593213cce4b9ffc5ba9900cce0, type: 3}
  nomeCenario: "A casa sil\xEAnciosa "
  imagemConclusao: {fileID: -7191073555793734665, guid: f9c778b88e296d54fa5a35a50f7a2fd8, type: 3}
  quadros:
  - titulo: A casa ficou silenciosa
    texto: "A tarde chega devagar e o tempo passa devagar. Seu Ant\xF4nio, aos 74
      anos, est\xE1 sentado na sua poltrona que se tornara sua \xFAltima companheira
      . Ao seu redor, ele apenas escuta a voz do silencio \u2014 os porta-retratos
      que guardam memorias de tempos que n\xE3o voltar\xE3o\_ \u2014, mas o que mais
      o incomoda \xE9 o sil\xEAncio que preenche toda a casa."
    imagem: {fileID: -2329959863234833854, guid: 26ed22e44825b4946a300c5e11e66ab3, type: 3}
    opcoes: []
    exigeEscolha: 0
    definirProximoQuadroManualmente: 0
    proximoQuadroSemEscolha: 0
  - titulo: A casa ficou silenciosa
    texto: "Mas o toque do telefone quebra esse silencio ensurdecedor. Era a sua
      filha que est\xE1 preocupada com o seu pai.\n"
    imagem: {fileID: -2329959863234833854, guid: 26ed22e44825b4946a300c5e11e66ab3, type: 3}
    opcoes: []
    exigeEscolha: 0
    definirProximoQuadroManualmente: 0
    proximoQuadroSemEscolha: 0
  - titulo: A casa ficou silenciosa
    texto: "Filha: Boa tarde pai, eu estou ligando para saber como v\xE3o as coisas,
      desde que a m\xE3e morreu eu ando preocupada com o senhor\_ "
    imagem: {fileID: 9094543361801899733, guid: 1b0dbf593213cce4b9ffc5ba9900cce0, type: 3}
    opcoes: []
    exigeEscolha: 0
    definirProximoQuadroManualmente: 0
    proximoQuadroSemEscolha: 0
  - titulo: A casa ficou silenciosa
    texto: "Olhando para a mesa que arrumara para tomar um caf\xE9, um costume que
      Seu Ant\xF4nio ainda mantinha vivo ele hesita para desabafar que o que mais
      lhe, \xE9 que as mem\xF3rias e o bons tempos n\xE3o voltam e que a solid\xE3o
      se tornara a sua nova companheira."
    imagem: {fileID: 9094543361801899733, guid: 1b0dbf593213cce4b9ffc5ba9900cce0, type: 3}
    opcoes: []
    exigeEscolha: 0
    definirProximoQuadroManualmente: 0
    proximoQuadroSemEscolha: 0
  - titulo: A casa ficou silenciosa
    texto: "narra\xE7\xE3o: Em sua pr\xF3pria casa Catarina , n\xE3o sabe o que fazer,
      ela est\xE1 cansada e com a consci\xEAncia pesada. O peso da semana recai sobre
      seus ombros junto com a preocupa\xE7\xE3o as suas preocupa\xE7\xF5es ela se
      sente esgotada."
    imagem: {fileID: 1334960847774182391, guid: d7ebc84e59198b342a6c490236b34310, type: 3}
    opcoes: []
    exigeEscolha: 0
    definirProximoQuadroManualmente: 0
    proximoQuadroSemEscolha: 0
  - titulo: A casa ficou silenciosa
    texto: "narra\xE7\xE3o: Catarina est\xE1 em um dilema manter a sua dedica\xE7\xE3o
      ao trabalho ou oferecer a sua companhia para o sei pai que n\xE3o parece estar
      lidando bem com a solid\xE3o. O que ela deve fazer?"
    imagem: {fileID: 1334960847774182391, guid: d7ebc84e59198b342a6c490236b34310, type: 3}
    opcoes: []
    exigeEscolha: 0
    definirProximoQuadroManualmente: 0
    proximoQuadroSemEscolha: 0
  - titulo: escolha
    texto: 
    imagem: {fileID: 3736540879100028168, guid: f083b45aa53415640a72ebfbc53c87e6, type: 3}
    opcoes:
    - textoOpcao: "pai eu n\xE3o poderei ir na sua casa por um tempo devido ao meu
        trabalho ent\xE3o n\xE3o d\xE1 para visit\xE1-lo "
      textoConsequencia: 
      pontuacao: -2
      proximoQuadro: 7
    - textoOpcao: "o senhor deve estar se sentindo sozinho, mas eu n\xE3o posso visit\xE1-lo
        ainda mas eu prometo que vou ligar mais "
      textoConsequencia: 
      pontuacao: -1
      proximoQuadro: 9
    - textoOpcao: "Pergunta se ele quer companhia, mas deixa a decis\xE3o totalmente
        por conta dele."
      textoConsequencia: 
      pontuacao: 0
      proximoQuadro: 11
    - textoOpcao: "Combina de visit\xE1-lo com mais frequ\xEAncia e procura manter
        contato durante a semana."
      textoConsequencia: 
      pontuacao: 1
      proximoQuadro: 13
    - textoOpcao: "Conversa com ele sobre o que est\xE1 sentindo"
      textoConsequencia: 
      pontuacao: 2
      proximoQuadro: 16
    exigeEscolha: 1
    definirProximoQuadroManualmente: 0
    proximoQuadroSemEscolha: 0
  - titulo: 
    texto: "Narra\xE7\xE3o: Com um suspiro de exaust\xE3o, Catarina afasta o celular
      e decide n\xE3o ir visit\xE1-lo, ela vai ter uma semana dif\xEDcil no trabalho
      e ela precisa aproveitar os momentos que tem para descansar e retribuir depois
      quando der. "
    imagem: {fileID: -995822636085515590, guid: 31e30c633e5891843919ecaf31f767e7, type: 3}
    opcoes: []
    exigeEscolha: 0
    definirProximoQuadroManualmente: 1
    proximoQuadroSemEscolha: 8
  - titulo: 
    texto: "Na casa vazia, o isolamento de Seu Ant\xF4nio se aprofunda.\n"
    imagem: {fileID: -4923229942648506911, guid: 3f814dc4e668fcb40a3e5a684e61107c, type: 3}
    opcoes: []
    exigeEscolha: 0
    definirProximoQuadroManualmente: 1
    proximoQuadroSemEscolha: 19
  - titulo: 
    texto: "narra\xE7\xE3o: ela tenta manter mais contato com o seu pai por meio
      de liga\xE7\xF5es mas a sua rotina pesada torna as visitas a ele quase proibitivas
      para ela."
    imagem: {fileID: 9193702694993886150, guid: 9b5e02aa615454241992d09db09f0c40, type: 3}
    opcoes: []
    exigeEscolha: 0
    definirProximoQuadroManualmente: 1
    proximoQuadroSemEscolha: 10
  - titulo: 
    texto: "narra\xE7\xE3o: ela tenta manter mais contato com o seu pai por meio
      de liga\xE7\xF5es mas a sua rotina pesada torna as visitas a ele quase proibitivas
      para ela."
    imagem: {fileID: -4923229942648506911, guid: 3f814dc4e668fcb40a3e5a684e61107c, type: 3}
    opcoes: []
    exigeEscolha: 0
    definirProximoQuadroManualmente: 1
    proximoQuadroSemEscolha: 19
  - titulo: 
    texto: "Pai, como est\xE1 se sentindo, eu sei que \xE9 um momento complicado
      se o senhor quiser eu posso visit\xE1-lo quando precisar."
    imagem: {fileID: 8538734835328285091, guid: 68088e0297764094e970e964e3d2a000, type: 3}
    opcoes: []
    exigeEscolha: 0
    definirProximoQuadroManualmente: 1
    proximoQuadroSemEscolha: 12
  - titulo: 
    texto: "narra\xE7\xE3o: ela percebe que o seu pai est\xE1 se sentindo s\xF3,
      ent\xE3o ela reorganiza a sua rotina, podendo visit\xE1-lo em poucos momentos,
      para que seu velho pai n\xE3o sofra tanto "
    imagem: {fileID: 5097590544626389610, guid: b10a96b823eaea54aad652465c824fbc, type: 3}
    opcoes: []
    exigeEscolha: 0
    definirProximoQuadroManualmente: 1
    proximoQuadroSemEscolha: 19
  - titulo: 
    texto: "narra\xE7\xE3o:. Ela organiza a sua rotina e anota os compromissos em
      sua agenda, para poderse organizar e fazer visitas com mais frequ\xEAncia mesmo
      com uma rotina puxada."
    imagem: {fileID: -1561652621127624007, guid: 4ffc35dcdb608354ab2caf6673e870ec, type: 3}
    opcoes: []
    exigeEscolha: 0
    definirProximoQuadroManualmente: 1
    proximoQuadroSemEscolha: 14
  - titulo: 
    texto: "Fala: pai, eu tenho me organizando e eu consegui alguns dias livres para
      visit\xE1-lo e fazer companhia, \xE9 um momento dif\xEDcil para o senhor, por
      isso vou ajud\xE1-lo no que der !"
    imagem: {fileID: 6028183830578997635, guid: c7f1f9227b826c445ac0f43c78b6d842, type: 3}
    opcoes: []
    exigeEscolha: 0
    definirProximoQuadroManualmente: 1
    proximoQuadroSemEscolha: 15
  - titulo: 
    texto: "narra\xE7\xE3o: com as iniciativa da filaha Seu Ant\xF4nio fica feliz\_
      pois sabe que a filha \xE9 muito ocupada e mesmo assim ela faz o poss\xEDvel
      para visit\xE1-lo."
    imagem: {fileID: 6028183830578997635, guid: c7f1f9227b826c445ac0f43c78b6d842, type: 3}
    opcoes: []
    exigeEscolha: 0
    definirProximoQuadroManualmente: 1
    proximoQuadroSemEscolha: 19
  - titulo: 
    texto: "Fala: pai eu irei visit\xE1-lo ,n\xE3o se preocupe eu tenho tempo livre
      para velo e tamb\xE9m vou levar o Mateus junto comigo, o senhor est\xE1 passando
      por uma situa\xE7\xE3o complicada ent\xE3o eu fasso quest\xE3o de visit\xE1-lo."
    imagem: {fileID: -7933959484852203323, guid: df4bcc52276f0e944bec15bfd40d4972, type: 3}
    opcoes: []
    exigeEscolha: 0
    definirProximoQuadroManualmente: 1
    proximoQuadroSemEscolha: 17
  - titulo: 
    texto: "narra\xE7\xE3o: Catarina toma a iniciativa e se organiza para poder visit\xE1-lo,
      se abstendo de compromisso\_ e tamb\xE9m leva o seu filho junto para ele tamb\xE9m
      fazer companhia ao seu av\xF4."
    imagem: {fileID: 2179803957164162282, guid: f8ac7ce813f08ee4fbbd05b3c327407d, type: 3}
    opcoes: []
    exigeEscolha: 0
    definirProximoQuadroManualmente: 1
    proximoQuadroSemEscolha: 18
  - titulo: 
    texto: "narra\xE7\xE3o: a casa de Seu Ant\xF4nio come\xE7ou a ganhar vida novamente,
      o sil\xEAncio\_ que o incomodava foi substitu\xEDdo por conversas e risos,
      memos com dificuldades Catarina faz quest\xE3o de visit\xE1-lo e o apoi\xE1-lo."
    imagem: {fileID: -3785770787563733714, guid: acc9a2d1ab9a90846a78a0e0ede88c01, type: 3}
    opcoes: []
    exigeEscolha: 0
    definirProximoQuadroManualmente: 1
    proximoQuadroSemEscolha: 19
