%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 71c832e2ef55603488cb697eb71901c4, type: 3}
  m_Name: cenario5
  m_EditorClassIdentifier: Assembly-CSharp::DadosCenario
  imagemCapa: {fileID: -6155285119414569528, guid: 5b05c210de1dbe04e9fdbb2e1e5afbff, type: 3}
  nomeCenario: Ele estava bem ali
  imagemConclusao: {fileID: 0}
  quadros:
  - titulo: 
    texto: "Seu Roberto, 76 anos, est\xE1 sentado com a filha e o neto enquanto eles
      conversam sobre ele."
    imagem: {fileID: -6155285119414569528, guid: 5b05c210de1dbe04e9fdbb2e1e5afbff, type: 3}
    opcoes: []
    exigeEscolha: 0
    definirProximoQuadroManualmente: 0
    proximoQuadroSemEscolha: 0
  - titulo: 
    texto: "\u2014 \u201CEle est\xE1 ficando velho, ent\xE3o acho melhor a gente
      come\xE7ar a decidir essas coisas por ele.\u201D"
    imagem: {fileID: -2365893456115379719, guid: 50e22e41c6e977a479d97a62bed9faa5, type: 3}
    opcoes: []
    exigeEscolha: 0
    definirProximoQuadroManualmente: 0
    proximoQuadroSemEscolha: 0
  - titulo: 
    texto: "\u2014 \u201C\xC9, n\xE3o adianta perguntar; ele provavelmente nem vai
      saber o que \xE9 melhor.\u201D"
    imagem: {fileID: 6487594331628864252, guid: b82c06eefd433dc4ea517703da220c13, type: 3}
    opcoes: []
    exigeEscolha: 0
    definirProximoQuadroManualmente: 0
    proximoQuadroSemEscolha: 0
  - titulo: problema
    texto: "Seu Roberto escuta tudo em sil\xEAncio, percebendo que ningu\xE9m sequer
      perguntou o que ele queria."
    imagem: {fileID: 6776986057483616195, guid: 72d4fe20c381df9438b8d7b5e31db590, type: 3}
    opcoes: []
    exigeEscolha: 0
    definirProximoQuadroManualmente: 0
    proximoQuadroSemEscolha: 0
  - titulo: decisao
    texto: 
    imagem: {fileID: 6776986057483616195, guid: 72d4fe20c381df9438b8d7b5e31db590, type: 3}
    opcoes:
    - textoOpcao: "Deixaria a fam\xEDlia decidir tudo por ele, afinal eles sabem
        o que \xE9 melhor."
      textoConsequencia: "Com o cora\xE7\xE3o apertado, Seu Roberto se sente cada
        vez ,mais longe da fam\xEDlia . Nos dias seguintes, a filha muda o hor\xE1rio
        dos rem\xE9dios, marca um m\xE9dico novo e anota tudo no calend\xE1rio da
        parede. Ele s\xF3 fica sabendo depois. \xC0 tarde, enquanto a filha e o neto
        conversam \xE0 mesa, Seu Roberto continua na poltrona, bem ali, em sil\xEAncio.
        J\xE1 n\xE3o espera que perguntem nada a ele."
      textoFeedback: 
      pontuacao: -2
      proximoQuadro: 5
    - textoOpcao: "Deixaria a fam\xEDlia cuidar das decis\xF5es, mas tentaria garantir
        que ele fosse tratado com respeito."
      textoConsequencia: "Passam-se alguns dias. A filha e o neto agora tratam Seu
        Roberto com mais respeito: n\xE3o falam mais dele pelas costas e sempre avisam
        o que foi decidido. Quando mudam o hor\xE1rio do rem\xE9dio, a filha vai
        at\xE9 a poltrona para contar a ele. Seu Roberto concorda com a cabe\xE7a.
        Ele \xE9 ouvido com educa\xE7\xE3o, mas as decis\xF5es continuam sendo tomadas
        sem ele."
      textoFeedback: 
      pontuacao: -1
      proximoQuadro: 6
    - textoOpcao: "Perguntaria a Seu Roberto o que ele pensa antes de tomar qualquer
        decis\xE3o."
      textoConsequencia: "Nos dias seguintes, a conversa come\xE7a a trazer pequenas
        mudan\xE7as na conviv\xEAncia familiar. A filha e o neto passam a demonstrar
        mais considera\xE7\xE3o por Seu Roberto, perguntando sua opini\xE3o sobre
        algumas quest\xF5es do dia a dia, como o almo\xE7o ou os passeios de fim
        de semana. Por\xE9m, as decis\xF5es sobre seus rem\xE9dios e consultas continuam
        sendo tomadas sem ele. Embora perceba que algo mudou, Seu Roberto ainda n\xE3o
        sabe se sua voz ser\xE1 ouvida no que realmente importa"
      textoFeedback: 
      pontuacao: 0
      proximoQuadro: 8
    - textoOpcao: "Conversaria diretamente com Seu Roberto e provavelmente consideraria
        sua opini\xE3o."
      textoConsequencia: "Com o passar das semanas, a fam\xEDlia come\xE7a a mudar
        sua postura em rela\xE7\xE3o a Seu Roberto. A filha e o neto passam a consult\xE1-lo
        com mais frequ\xEAncia, inclusive sobre os hor\xE1rios dos rem\xE9dios e
        as consultas m\xE9dicas, e consideram suas prefer\xEAncias antes de decidir.
        \xC0s vezes, a filha ainda d\xE1 a palavra final, mas agora explica os motivos
        e escuta o que ele tem a dizer. Embora ainda estejam aprendendo a respeitar
        sua autonomia, Seu Roberto volta a se sentir parte das decis\xF5es sobre
        a pr\xF3pria vida."
      textoFeedback: 
      pontuacao: 1
      proximoQuadro: 12
    - textoOpcao: "Conversaria com Seu Roberto, ouviria suas prefer\xEAncias e respeitaria
        sua decis\xE3o."
      textoConsequencia: "Alguns dias depois, Seu Roberto percebe mudan\xE7as na
        conviv\xEAncia familiar. Na consulta seguinte, \xE9 ele quem conversa com
        o m\xE9dico e decide, junto com ele, o novo hor\xE1rio dos rem\xE9dios, e
        a filha apenas o acompanha. Em casa, ainda precisa de ajuda em algumas tarefas,
        mas agora \xE9 ele quem diz quando e como quer ser ajudado. \xC0 tarde, quando
        a filha e o neto se sentam \xE0 mesa para o caf\xE9, Seu Roberto j\xE1 n\xE3o
        fica na poltrona: est\xE1 sentado com eles, participando da conversa"
      textoFeedback: 
      pontuacao: 2
      proximoQuadro: 15
    exigeEscolha: 1
    definirProximoQuadroManualmente: 0
    proximoQuadroSemEscolha: 0
  - titulo: 
    texto: "Narra\xE7\xE3o: Sentindo o peso de n\xE3o confiarem em suas escolhas,
      Seu Roberto se afasta da porta cabisbaixo, conformando-se sobre perder o controle
      sobre as decis\xF5es de sua pr\xF3pria exist\xEAncia e aceitando passivamente
      a tutela familiar."
    imagem: {fileID: -7604003618190317557, guid: c43c3a3c68a65ea4686e79c421f7463d, type: 3}
    opcoes: []
    exigeEscolha: 0
    definirProximoQuadroManualmente: 1
    proximoQuadroSemEscolha: 20
  - titulo: 
    texto: "Narra\xE7\xE3o: Decidindo n\xE3o se esconder mais, Seu Roberto abre a
      porta da sala de jantar e senta-se \xE0 mesa com a filha e o neto, decidido
      a confrontar a situa\xE7\xE3o e exigir ser ouvido."
    imagem: {fileID: 2049805542666589774, guid: 271f69527ef05324f841f339c1388bf9, type: 3}
    opcoes: []
    exigeEscolha: 0
    definirProximoQuadroManualmente: 1
    proximoQuadroSemEscolha: 7
  - titulo: 
    texto: "Fala de Seu Roberto: Eu aceito que me ajudem no que for preciso, mas
      exijo que voc\xEAs me tratem com respeito e me ou\xE7am antes de decidir qualquer
      coisa sobre a minha vida."
    imagem: {fileID: -5288849906283564437, guid: 589c43f6ac5a3524f935133b6fc51467, type: 3}
    opcoes: []
    exigeEscolha: 0
    definirProximoQuadroManualmente: 1
    proximoQuadroSemEscolha: 20
  - titulo: 
    texto: "Narra\xE7\xE3o: Ao perceber que a conversa envolve sua vida, Seu Roberto
      abre a porta da sala de jantar e se aproxima da mesa. Ainda incomodado com
      o que ouviu, pergunta o que estavam discutindo e por que n\xE3o falaram diretamente
      com ele."
    imagem: {fileID: 8271236950401246202, guid: 80df9fc350b49224f92c28cc5a7d2093, type: 3}
    opcoes: []
    exigeEscolha: 0
    definirProximoQuadroManualmente: 1
    proximoQuadroSemEscolha: 9
  - titulo: 
    texto: "Fala de Seu Roberto:\nEu ouvi voc\xEAs conversando sobre mim. Por que
      n\xE3o me perguntaram o que eu penso antes de decidir essas coisas?"
    imagem: {fileID: 8271236950401246202, guid: 80df9fc350b49224f92c28cc5a7d2093, type: 3}
    opcoes: []
    exigeEscolha: 0
    definirProximoQuadroManualmente: 1
    proximoQuadroSemEscolha: 10
  - titulo: 
    texto: "Fala da filha:\nN\xF3s s\xF3 est\xE1vamos tentando entender o que seria
      melhor para o senhor, pai."
    imagem: {fileID: -8033534013178356070, guid: e554539a8bb72164ba839ba4b045a593, type: 3}
    opcoes: []
    exigeEscolha: 0
    definirProximoQuadroManualmente: 1
    proximoQuadroSemEscolha: 11
  - titulo: 
    texto: "Narra\xE7\xE3o: A fam\xEDlia interrompe a conversa para ouvir Seu Roberto.
      Embora ainda n\xE3o tenham pensado se suas opini\xF5es ser\xE3o consideradas."
    imagem: {fileID: -8033534013178356070, guid: e554539a8bb72164ba839ba4b045a593, type: 3}
    opcoes: []
    exigeEscolha: 0
    definirProximoQuadroManualmente: 1
    proximoQuadroSemEscolha: 20
  - titulo: 
    texto: "Fala de Seu Roberto:\n Eu entendo que voc\xEAs se preocupam com meus
      hor\xE1rios e meus rem\xE9dios, mas preciso que me consultem antes de decidir
      as coisas por mim. Quero continuar participando das escolhas sobre minha rotina
      e minha casa."
    imagem: {fileID: -1897867357772833244, guid: 313ca4a2c92215b40a9134e602e3fe00, type: 3}
    opcoes: []
    exigeEscolha: 0
    definirProximoQuadroManualmente: 1
    proximoQuadroSemEscolha: 13
  - titulo: 
    texto: "Fala da filha:\nTem raz\xE3o, pai. Desculpe por termos conversado sobre
      o senhor sem inclu\xED-lo. Vamos ouvir o que pensa antes de tomar qualquer
      decis\xE3o."
    imagem: {fileID: -9141078977680352108, guid: 145828290beef6d48adfc841fc33b64b, type: 3}
    opcoes: []
    exigeEscolha: 0
    definirProximoQuadroManualmente: 1
    proximoQuadroSemEscolha: 14
  - titulo: 
    texto: "Narra\xE7\xE3o: A filha reconhece que deveria ter inclu\xEDdo o pai na
      conversa e se disp\xF5e a considerar suas prefer\xEAncias. Apesar disso, a
      fam\xEDlia ainda precisa aprender a equilibrar suas preocupa\xE7\xF5es com
      o respeito \xE0s decis\xF5es de Seu Roberto."
    imagem: {fileID: -9141078977680352108, guid: 145828290beef6d48adfc841fc33b64b, type: 3}
    opcoes: []
    exigeEscolha: 0
    definirProximoQuadroManualmente: 1
    proximoQuadroSemEscolha: 20
  - titulo: 
    texto: "Narra\xE7\xE3o: Decidindo n\xE3o se calar, Seu Roberto abre a porta da
      sala de jantar e se aproxima da mesa. A filha e o neto percebem sua presen\xE7a
      e se d\xE3o conta de que ele ouviu a conversa. Em vez de se justificarem, interrompem
      o que estavam fazendo e lhe oferecem espa\xE7o \xE0 mesa."
    imagem: {fileID: -705960573741391066, guid: 0ef4f1fcc0ee54a4e902c1cecaf9113d, type: 3}
    opcoes: []
    exigeEscolha: 0
    definirProximoQuadroManualmente: 1
    proximoQuadroSemEscolha: 16
  - titulo: 
    texto: "Fala de Seu Roberto:\nEu sei que voc\xEAs se preocupam comigo, e agrade\xE7o
      por isso. Mas quero que conversem comigo, n\xE3o apenas sobre mim. Posso aceitar
      ajuda sem deixar de decidir sobre a minha pr\xF3pria vida."
    imagem: {fileID: -705960573741391066, guid: 0ef4f1fcc0ee54a4e902c1cecaf9113d, type: 3}
    opcoes: []
    exigeEscolha: 0
    definirProximoQuadroManualmente: 1
    proximoQuadroSemEscolha: 17
  - titulo: 
    texto: "Fala da filha:\nO senhor tem toda a raz\xE3o, pai. Desculpe por termos
      decidido as coisas sem ouvir voc\xEA. Sua opini\xE3o importa, e queremos que
      participe de todas as decis\xF5es que dizem respeito \xE0 sua vida."
    imagem: {fileID: 7306352978364405215, guid: 2318bd55fc6e8c94095a1c4d9fe602a3, type: 3}
    opcoes: []
    exigeEscolha: 0
    definirProximoQuadroManualmente: 1
    proximoQuadroSemEscolha: 18
  - titulo: 
    texto: "Fala do neto: \xC9, v\xF4. A gente devia ter perguntado o que voc\xEA
      queria primeiro. Queremos ajudar, mas tamb\xE9m queremos ouvir o que voc\xEA
      tem a dizer. "
    imagem: {fileID: 7306352978364405215, guid: 2318bd55fc6e8c94095a1c4d9fe602a3, type: 3}
    opcoes: []
    exigeEscolha: 0
    definirProximoQuadroManualmente: 1
    proximoQuadroSemEscolha: 19
  - titulo: 
    texto: "Narra\xE7\xE3o: A fam\xEDlia reconhece a import\xE2ncia de respeitar
      a autonomia de Seu Roberto e passa a inclu\xED-lo nas decis\xF5es, oferecendo
      apoio sem retirar sua independ\xEAncia."
    imagem: {fileID: 7306352978364405215, guid: 2318bd55fc6e8c94095a1c4d9fe602a3, type: 3}
    opcoes: []
    exigeEscolha: 0
    definirProximoQuadroManualmente: 1
    proximoQuadroSemEscolha: 20
