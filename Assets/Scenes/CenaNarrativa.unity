  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Este jogo aborda o etarismo, o preconceito e a discrimina\xE7\xE3o direcionados
    \xE0s pessoas em raz\xE3o da idade, especialmente \xE0 popula\xE7\xE3o idosa.\n\nPor
    meio de diferentes cenas e personagens, o jogador \xE9 apresentado a situa\xE7\xF5es
    cotidianas que evidenciam como o etarismo pode se manifestar em diversas rela\xE7\xF5es
    sociais. Em cada cen\xE1rio, \xE9 poss\xEDvel escolher entre cinco alternativas
    de resposta, cada uma com diferentes consequ\xEAncias e pesos dentro da narrativa.\n\nA
    proposta \xE9 estimular a reflex\xE3o sobre atitudes, julgamentos e comportamentos
    relacionados ao envelhecimento, destacando a import\xE2ncia do respeito, da empatia
    e da valoriza\xE7\xE3o das pessoas idosas."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
